ANTHROPIC_API_KEY=sk-ant-your-key-here
MONDAY_API_TOKEN=your-monday-api-v2-token-here
MONDAY_BOARD_ID=1835197092
# Optional: only needed for the "flag as rush" auto-email feature
FRAMING_TEAM_EMAIL=framing@theprinthouse.co.il
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-sending-account@theprinthouse.co.il
SMTP_PASSWORD=your-app-password-here
# Optional: background inbox poller (drafts confident replies, never sends).
# Reuses SMTP_USERNAME/SMTP_PASSWORD above for IMAP login (same Gmail App
# Password works for both). Off by default -- explicitly set to "true" to
# enable once SMTP_USERNAME/PASSWORD are real.
EMAIL_POLLER_ENABLED=false
EMAIL_POLLER_INTERVAL_MINUTES=10
# Optional: persistent learning log (see LEARNING_LOG_PATH / PRICING_DATA_PATH
# pattern) so the daily report survives redeploys instead of resetting.
# LEARNING_LOG_PATH=/home/deploy/pricing-calc/shared/learning_log.jsonl
# Optional: daily .docx email summarizing what the poller learned that day
# (see daily_report.py). Reuses SMTP_USERNAME/SMTP_PASSWORD above. Off by default.
DAILY_REPORT_ENABLED=false
DAILY_REPORT_RECIPIENT=rea@theprinthouse.co.il
DAILY_REPORT_TIME=18:00
# Shared password for the browser UI (optional locally; omit on staging/production).
# APP_PASSWORD=your-shared-password
# Machine-to-machine API key for Opics (and other server clients).
# - API calls: header X-Pricing-Calc-Key: <value>
# - Iframe embed: /auth/from_opics?key=<value> (opens a session, no password form)
# On staging/production: set this key; leave APP_PASSWORD unset. nginx injects the header.
PRICING_CALC_API_KEY=change-me-to-a-long-random-secret
# Optional: subpath when not using X-Script-Name from nginx
# APPLICATION_ROOT=/pricing-calculator
# Optional: persistent pricing data (set in systemd unit on server)
# PRICING_DATA_PATH=/home/deploy/pricing-calc/shared/pricing_data.json
